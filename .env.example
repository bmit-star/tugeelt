# Server Environment Configuration
NODE_ENV=development
PORT=3000

# Security & Sessions
SESSION_SECRET=
MANAGER_PASSWORD=

# Database Configuration
# Defaults to data/fleet.sqlite using WAL mode
DATABASE_URL=

# Firebase Cloud & Auth
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GPSBox Telematics API
GPSBOX_API_URL=
GPSBOX_USERNAME=
GPSBOX_API_KEY=

# Google Apps Script Microservice (Document & Letter generation)
APP_SCRIPT_URL=
APP_SCRIPT_SECRET=

# Google OAuth & Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public App Hosting URL
APP_URL=

# Storage & Backups
STORAGE_PROVIDER=local
STORAGE_BUCKET=
